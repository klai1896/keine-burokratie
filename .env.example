DATABASE_URL=postgresql://postgres:postgres@localhost:5432/keine_burokratie
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used for hashing tokens stored in URLs and emails — set a strong value in production
APP_SECRET=change-me-for-production

# Optional: Resend for transactional email (otherwise emails are logged to console in dev)
# RESEND_API_KEY=
# RESEND_FROM="Keine Bürokratie <notifications@yourdomain.com>"

# Berlin fetch: set to 1 to avoid HTTP calls and return empty JSON slots (dev)
# BERLIN_FETCH_MOCK=1

# Poller target interval (seconds) — product target 60; increase if upstream blocks
# MIN_POLL_INTERVAL_SEC=60
